# Supabase Configuration
# Used across the entire project (Frontend & Vercel Backend)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Backend / Server / Admin Service Role Key
# Used ONLY by Vercel Serverless Functions (api/) — never exposed to frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
