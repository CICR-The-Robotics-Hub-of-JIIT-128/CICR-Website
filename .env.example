# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Client / Frontend (Vite)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend / Server / Node / Python scripts
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Backend / Server / Admin Service Role Key (Used ONLY by serverless functions & scripts)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==============================================================================
# Google Drive Certificate Folders
# ==============================================================================
# Google Drive Parent Folder (URL or ID)
GOOGLE_DRIVE_FOLDER_ID=your-parent-folder-id-here

# Optional: Direct Subfolder IDs (auto-discovered if omitted)
PARTICIPATION_GOOGLE_DRIVE_FOLDER_ID=your-participation-subfolder-id-here
CONTRIBUTION_GOOGLE_DRIVE_FOLDER_ID=your-contribution-subfolder-id-here

# ==============================================================================
# Local Data & Database Schema Configurations
# ==============================================================================
TEAM_RESPONSES_CSV=src/data/team_responses.csv
CERTIFICATES_SCHEMA=techtonic2.0_certificates/schema.sql
